# 后端环境变量示例
# 复制为 .env 后按实际情况填写

# ── 基础配置 ──────────────────────────────────────
QUANT_ETF_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quant_etf
QUANT_ETF_APP_ENV=development
QUANT_ETF_APP_HOST=0.0.0.0
QUANT_ETF_APP_PORT=8000
QUANT_ETF_CORS_ORIGINS=["http://localhost:5173"]

# ── 定时调度 ──────────────────────────────────────
# 是否启用每日收盘后自动数据摄取（默认 true）
# QUANT_ETF_SCHEDULE_ENABLED=true
# 每日自动摄取触发时间（HH:MM），默认收盘后 17:30
# QUANT_ETF_SCHEDULE_TIME=17:30
# 系统启动时是否自动检查并补全数据缺口（默认 true）
# QUANT_ETF_STARTUP_FILL_ENABLED=true

# ── 后台任务队列（回测/摄取并发预算与异常回收，B1/B6/B7）──
# 通用 lane worker 线程数（因子计算、数据摄取等，默认 2）
# QUANT_ETF_JOB_QUEUE_WORKERS=2
# 回测 lane worker 线程数（回测并发预算，默认 1=串行；实测并发比串行慢）
# QUANT_ETF_JOB_QUEUE_BACKTEST_WORKERS=1
# API 进程内是否启动 worker；部署独立 worker 进程时设为 false
#   python -m quant_etf_api.worker        （或 python -m quant_etf_api.cli queue worker）
# QUANT_ETF_JOB_QUEUE_EMBEDDED=true
# 队列空转轮询间隔，秒（默认 1.0）
# QUANT_ETF_JOB_POLL_INTERVAL_SECONDS=1.0
# 任务心跳写库间隔，秒（默认 15）
# QUANT_ETF_JOB_HEARTBEAT_INTERVAL_SECONDS=15
# 心跳超时阈值，秒（超过即视为卡死并回收，默认 1800）
# QUANT_ETF_JOB_STUCK_TIMEOUT_SECONDS=1800
# 是否启用运行期僵尸任务扫描（默认 true）
# QUANT_ETF_JOB_ZOMBIE_SCAN_ENABLED=true
# 僵尸任务扫描间隔，秒（默认 60）
# QUANT_ETF_JOB_ZOMBIE_SCAN_INTERVAL_SECONDS=60
# 单任务最长运行时间，秒（0=不限制；默认 7200）
# QUANT_ETF_JOB_MAX_RUNTIME_SECONDS=7200

# ── 回测口径与结果可信度（C1~C6） ──────────────────
# 净口径并列展示的成本档位（基点，JSON 数组；0 表示毛口径）
#   READ 路径现算，无需重跑回测
# QUANT_ETF_STABILITY_COST_LADDER=[0, 0.5, 5, 10]
# 有效候选池剔除明细（指数—日期区间）保留条数上限（默认 50）
# QUANT_ETF_CANDIDATE_POOL_EXCLUSION_LIMIT=50
# 说明：交易日历为严格口径（C1），只接受上游 Tushare/AkShare 或本地
#   trading_calendar 表快照；取不到有效日历会直接报错，**不存在**
#   任何"按周末近似"的降级开关。

# ── 日志 ──────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
# QUANT_ETF_LOG_LEVEL=INFO
# JSON 日志文件路径，留空则仅输出到控制台
# QUANT_ETF_LOG_FILE=

# ── 多数据源指数日线摄取 ──────────────────────────
# 指数日线多数据源优先级（逗号分隔），可选 akshare/tickflow/tushare/baostock
# 切换规则：按优先级拉取，OHLC 任一缺失或成交量缺失超过 1% 即视为不合格并降级，
# 最终按 (OHLC 缺失, 成交量缺失) 采用缺失最少的数据源；tushare 未配置 Token 时自动跳过
# QUANT_ETF_INDEX_DAILY_SOURCE_ORDER=tushare,akshare,tickflow,baostock
# TickFlow API Key（可选）：不配置则自动使用免费服务（free-api.tickflow.org，
# 无需注册，仅提供历史日 K 线；限流默认 60 次/分钟）
# QUANT_ETF_TICKFLOW_API_KEY=
# TickFlow 调用最小间隔，秒（免费档按 IP 限流，默认 1.2）
# TICKFLOW_INDEX_MIN_INTERVAL=1.2
# Tushare Pro API Token，配置后启用 tushare 指数日线源（未配置自动跳过）
# QUANT_ETF_TUSHARE_TOKEN=
# Tushare 调用最小间隔，秒（免费档有频次限制，默认 1.0）
# TUSHARE_INDEX_MIN_INTERVAL=1.0
