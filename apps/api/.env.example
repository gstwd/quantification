# 后端环境变量示例
# 复制为 .env 后按实际情况填写

# ── 基础配置 ──────────────────────────────────────
QUANT_ETF_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quant_etf
QUANT_ETF_APP_ENV=development
QUANT_ETF_APP_HOST=0.0.0.0
QUANT_ETF_APP_PORT=8000
QUANT_ETF_CORS_ORIGINS=["http://localhost:5173"]

# ── 定时调度 ──────────────────────────────────────
# 是否启用每日收盘后自动数据摄取（默认 true）
# QUANT_ETF_SCHEDULE_ENABLED=true
# 每日自动摄取触发时间（HH:MM），默认收盘后 17:30
# QUANT_ETF_SCHEDULE_TIME=17:30
# 系统启动时是否自动检查并补全数据缺口（默认 true）
# QUANT_ETF_STARTUP_FILL_ENABLED=true

# ── AI 舆情分析 ───────────────────────────────────
# 是否在日频调度中自动触发 AI 舆情分析（默认 true）
# QUANT_ETF_AI_ANALYSIS_ENABLED=true
# AI 舆情分析触发时间（HH:MM），默认夜里 23:30，覆盖当天全部新闻
# QUANT_ETF_AI_SCHEDULE_TIME=23:30

# ── LLM 配置（可选，不配置则 AI 分析功能不可用）──
# LLM API Key（必填，否则 AI 分析无法使用）
# QUANT_ETF_LLM_API_KEY=sk-your-api-key-here
# LLM API Base URL（OpenAI 兼容接口），不填则使用模型默认网关
# QUANT_ETF_LLM_BASE_URL=https://api.deepseek.com/v1
# 默认模型标识（LiteLLM 格式：provider/model）
# QUANT_ETF_LLM_MODEL=deepseek/deepseek-chat
# AI 分析最大输出 token 数（默认 4096）
# QUANT_ETF_LLM_MAX_TOKENS=4096
# AI 分析温度参数（默认 0.3）
# QUANT_ETF_LLM_TEMPERATURE=0.3
# LLM 请求超时时间，秒（默认 60）
# QUANT_ETF_LLM_TIMEOUT_SECONDS=60

# ── 日志 ──────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
# QUANT_ETF_LOG_LEVEL=INFO
# JSON 日志文件路径，留空则仅输出到控制台
# QUANT_ETF_LOG_FILE=
