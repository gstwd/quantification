# 后端环境变量示例
# 复制为 .env 后按实际情况填写

# ── 基础配置 ──────────────────────────────────────
QUANT_ETF_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quant_etf
QUANT_ETF_APP_ENV=development
QUANT_ETF_APP_HOST=0.0.0.0
QUANT_ETF_APP_PORT=8000
QUANT_ETF_CORS_ORIGINS=["http://localhost:5173"]

# ── 定时调度 ──────────────────────────────────────
# 是否启用每日收盘后自动数据摄取（默认 true）
# QUANT_ETF_SCHEDULE_ENABLED=true
# 每日自动摄取触发时间（HH:MM），默认收盘后 17:30
# QUANT_ETF_SCHEDULE_TIME=17:30
# 系统启动时是否自动检查并补全数据缺口（默认 true）
# QUANT_ETF_STARTUP_FILL_ENABLED=true

# ── AI 舆情分析 ───────────────────────────────────
# 是否在日频调度中自动触发 AI 舆情分析（默认 true）
# QUANT_ETF_AI_ANALYSIS_ENABLED=true
# AI 舆情分析触发时间（HH:MM），默认夜里 23:30，覆盖当天全部新闻
# QUANT_ETF_AI_SCHEDULE_TIME=23:30

# ── LLM 配置（可选，不配置则 AI 分析功能不可用）──
# LLM API Key（必填，否则 AI 分析无法使用）
# QUANT_ETF_LLM_API_KEY=sk-your-api-key-here
# LLM API Base URL（OpenAI 兼容接口），不填则使用模型默认网关
# QUANT_ETF_LLM_BASE_URL=https://api.deepseek.com/v1
# 默认模型标识（LiteLLM 格式：provider/model）
# QUANT_ETF_LLM_MODEL=deepseek/deepseek-chat
# AI 分析最大输出 token 数（默认 4096）
# QUANT_ETF_LLM_MAX_TOKENS=4096
# AI 分析温度参数（默认 0.3）
# QUANT_ETF_LLM_TEMPERATURE=0.3
# LLM 请求超时时间，秒（默认 60）
# QUANT_ETF_LLM_TIMEOUT_SECONDS=60

# ── 日志 ──────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
# QUANT_ETF_LOG_LEVEL=INFO
# JSON 日志文件路径，留空则仅输出到控制台
# QUANT_ETF_LOG_FILE=

# ════════════════════════════════════════════════════
# 以下为新增功能配置，所有配置项均为可选。
# "可选"的含义：不配置 = 功能静默跳过，不影响现有逻辑。
# ════════════════════════════════════════════════════

# ── 数据源优先级 ──────────────────────────────────
# 逗号分隔的数据源名称列表，越靠前优先级越高。
# 当前可用的数据源名称（均由 AkShare 封装，免费无需配置）：
#   akshare_fund      — ETF K线、份额/规模数据（来源：新浪+东方财富）
#   akshare_index     — 指数日线、估值 PE/PB（内置腾讯→中证→东财三层降级）
#   akshare_macro     — 宏观指标 CPI/PMI/LPR
#   exchange_reference — 交易所参考数据（静态数据）
#
# 占位符（预留，尚未实现实际数据获取，配置对应凭证后自动激活）：
#   tushare           — Tushare Pro，需设置 TUSHARE_TOKEN（优先级高于 AkShare）
#   yfinance          — Yahoo Finance 海外市场，需设置 YFINANCE_ENABLED=true
#
# 值示例：
#   QUANT_ETF_DATA_SOURCE_PRIORITY=tushare,akshare_index,akshare_fund,akshare_macro,exchange_reference
# QUANT_ETF_DATA_SOURCE_PRIORITY=

# ── 熔断器配置 ────────────────────────────────────
# 数据源连续失败 N 次后进入熔断状态，冷却期内不再尝试。
# 用于防止上游 API 不稳定时反复重试拖垮整体性能。
#
# 连续失败次数阈值（默认 3）
# QUANT_ETF_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# 熔断冷却时间，秒（默认 300，即 5 分钟）
# QUANT_ETF_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# ════════════════════════════════════════════════════
# 新闻多源搜索（全部可选，仅在配置了对应 API Key 时激活）
#
# 优先级：Anspire > Bocha > Tavily > Brave > SerpAPI > SearXNG
# 每个搜索提供者均支持多个 Key（逗号分隔），自动轮询负载均衡。
# 单个 Key 连续失败 3 次后会被暂时跳过，所有 Key 都失败后重置。
# ════════════════════════════════════════════════════

# ── Anspire 搜索（最高优先级）────────────────────
# 实时智能搜索，汇聚全球舆情，适配 A 股/美股/港股新闻检索。
# 获取 API Key: https://open.anspire.cn/dsa?share_code=QFBC0FYC
# 多 Key 逗号分隔，如 "sk-aaa,sk-bbb"
# QUANT_ETF_ANSPIRE_API_KEYS=["sk-your-anspire-key"]

# ── Bocha 搜索（中文搜索优化）────────────────────
# 博查 AI 搜索，专注中文金融新闻，支持 AI 摘要。
# 获取 API Key: https://open.bocha.cn/
# QUANT_ETF_BOCHA_API_KEYS=["sk-your-bocha-key"]

# ── Tavily 搜索（AI 优化搜索）────────────────────
# 专为 AI/LLM 优化的搜索 API，每月免费 1000 次请求。
# 获取 API Key: https://tavily.com/
# 依赖: pip install tavily-python
# QUANT_ETF_TAVILY_API_KEYS=["tvly-your-tavily-key"]

# ── Brave 搜索（隐私优先，全球覆盖）──────────────
# Brave Search API，免费版每月 2000 次查询。
# 获取 API Key: https://brave.com/search/api/
# QUANT_ETF_BRAVE_API_KEYS=["BSA-your-brave-key"]

# ── SerpAPI（Google News 搜索）───────────────────
# 聚合 Google News 结构化搜索结果，免费版每月 100 次请求。
# 获取 API Key: https://serpapi.com/
# 依赖: pip install google-search-results
# QUANT_ETF_SERPAPI_API_KEYS=["your-serpapi-key"]

# ── SearXNG（无配额兜底搜索）────────────────────
# 开源元搜索引擎，支持自建实例或公共实例。
# 自建实例 URL 列表（逗号分隔），如 "https://searx.example.com"
# 不配置自建实例时，系统不会自动使用公共实例（需显式配置）。
# QUANT_ETF_SEARXNG_URLS=["https://searx.be","https://searx.tiekoetter.com"]

# ── 新闻搜索增强配置 ─────────────────────────────
# 单次 AI 分析最大新闻条数（默认 150），超出部分仅计算关注度不调用 LLM
# QUANT_ETF_AI_MAX_ANALYSIS_ITEMS=150

# ════════════════════════════════════════════════════
# 社交媒体情绪（可选，为未来美股 ETF 支持做准备）
# ════════════════════════════════════════════════════

# ── 社交媒体情绪 API ─────────────────────────────
# 通过 api.adanos.org 获取 Reddit / X / Polymarket 情绪数据。
# 仅对美股代码生效。不配置则功能不激活。
# 获取 API Key: https://api.adanos.org/docs
# QUANT_ETF_SOCIAL_SENTIMENT_API_KEY=sk_live_your_key_here

# ════════════════════════════════════════════════════
# 多渠道 LLM 配置（可选，为 AI 分析增加模型回退能力）
#
# 通过 LLM_CHANNELS 环境变量指定渠道名列表（逗号分隔），
# 每个渠道的详细配置通过 LLM_{NAME}_{FIELD} 格式的环境变量注入：
#   LLM_{NAME}_BASE_URL   — API 端点（OpenAI 兼容）
#   LLM_{NAME}_API_KEY    — API 密钥
#   LLM_{NAME}_MODELS     — 可用模型列表（逗号分隔）
#   LLM_{NAME}_TIMEOUT    — 请求超时（秒，默认 60）
#   LLM_{NAME}_MAX_TOKENS — 最大 token（默认 4096）
#   LLM_{NAME}_TEMPERATURE — 温度（默认 0.3）
#
# 未配置 LLM_CHANNELS 时，退化为单模型模式（使用 QUANT_ETF_LLM_* 配置）。
# ════════════════════════════════════════════════════

# 渠道列表（逗号分隔），如 "deepseek,aihubmix"
# LLM_CHANNELS=deepseek,aihubmix

# ── 渠道 1 示例: DeepSeek ─────────────────────────
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_DEEPSEEK_API_KEY=sk-your-deepseek-key
# LLM_DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# ── 渠道 2 示例: AIHubMix（多模型聚合网关）───────
# 一个 Key 切换使用 ChatGPT、Claude、Gemini 等全系模型。
# 注册：https://aihubmix.com/?aff=CfMq
# LLM_AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# LLM_AIHUBMIX_API_KEY=sk-your-aihubmix-key
# LLM_AIHUBMIX_MODELS=gpt-4o,claude-3.5-sonnet,gemini-2.0-flash

# ── 渠道 3 示例: Ollama 本地模型 ──────────────────
# LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_OLLAMA_API_KEY=ollama
# LLM_OLLAMA_MODELS=qwen2.5:7b

# ════════════════════════════════════════════════════
# 注意：
# 1. 所有 LLM_{NAME}_* 环境变量仅在 LLM_CHANNELS 中包含该渠道名时生效。
# 2. 多渠道模式下，渠道按 LLM_CHANNELS 中的顺序尝试；
#    当前渠道失败时自动切换到下一个渠道。
# 3. 单渠道模式下（LLM_CHANNELS 未配置），系统使用传统的
#    QUANT_ETF_LLM_* 配置，行为与之前完全一致。
# ════════════════════════════════════════════════════
