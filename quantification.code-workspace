{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/apps/api/.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    "python.analysis.extraPaths": ["${workspaceFolder}/apps/api/src"],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.cwd": "${workspaceFolder}/apps/api",
    "python.testing.pytestArgs": ["tests"],
    "terminal.integrated.cwd": "${workspaceFolder}/apps/api",
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
    },
  },
}
